# Hostvra Platform — Production Environment Configuration
# Copy this file to .env and edit with your production values

# ==============================================================================
# Server Environment
# ==============================================================================
ENVIRONMENT=production
PORT=8080
HOST=0.0.0.0
APP_URL=https://panel.yourdomain.com
API_URL=https://panel.yourdomain.com/api

# ==============================================================================
# Database (PostgreSQL) — Used by docker-compose.prod.yml
# ==============================================================================
POSTGRES_USER=hostvra
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password_here
POSTGRES_DB=hostvra
DATABASE_URL=postgres://hostvra:CHANGE_ME_strong_random_password_here@postgres:5432/hostvra?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# ==============================================================================
# Redis Cache & PubSub
# ==============================================================================
REDIS_URL=redis://redis:6379/0

# ==============================================================================
# Authentication & Security
# ==============================================================================
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_64
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=7
ARGON2_MEMORY_KB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2

# Admin bootstrap credentials (set on first startup)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# ==============================================================================
# CORS
# ==============================================================================
CORS_ALLOWED_ORIGINS=https://panel.yourdomain.com

# ==============================================================================
# Transactional Email (SMTP)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM=noreply@yourdomain.com
SMTP_FROM_NAME=Hostvra

# ==============================================================================
# Licensing
# ==============================================================================
HOSTVRA_LICENSE_ENDPOINT=https://license.hostvra.com/v1/verify
HOSTVRA_SYSTEM_EDITION=community

# ==============================================================================
# Logging
# ==============================================================================
LOG_LEVEL=info
LOG_FORMAT=json

# ==============================================================================
# Domain Reseller System (ResellerClub HTTP API)
# ==============================================================================
DOMAIN_REGISTRAR=resellerclub
RESELLERCLUB_MODE=sandbox
RESELLERCLUB_RESELLER_ID=your_reseller_id_here
RESELLERCLUB_API_KEY=your_resellerclub_api_key_here
RESELLERCLUB_API_BASE_URL=https://test.httpapi.com/api/
RESELLERCLUB_API_TIMEOUT_SECONDS=30
DOMAIN_DEFAULT_NS1=ns1.hostvra.com
DOMAIN_DEFAULT_NS2=ns2.hostvra.com
DOMAIN_ENCRYPTION_SECRET=CHANGE_ME_32_character_encryption_key

# ==============================================================================
# Docker Compose — Port Mapping
# ==============================================================================
HTTP_PORT=80
HTTPS_PORT=443
